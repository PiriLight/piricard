NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_. Powers the live Google
# rating/review-count fetch in lib/google-reviews.ts (Places API, Place
# Details). Without it, profile pages fall back to each business's static
# reviewSnapshot (or a "no verified rating yet" message) — nothing crashes.
GOOGLE_PLACES_API_KEY=

# --- Supabase (Phase 4B.1 — schema foundation only, NOT yet wired into the app) ---
# These are the PLAN for when a future phase connects the app to Supabase.
# No code currently reads them; adding them here does not change app behavior.
#
# Safe to expose to the browser: all authorization comes from Postgres GRANTs
# + Row Level Security (see supabase/migrations/*_piricard_v1_schema.sql), not
# from keeping this value secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, trusted-tooling key — never prefix with NEXT_PUBLIC_, never
# ship it in a client bundle, never use it for ordinary dashboard/profile
# operations to bypass RLS "for convenience". Reserved for admin scripts
# (e.g. provisioning the first platform admin, activating a module) run
# outside the public application.
SUPABASE_SECRET_KEY=
